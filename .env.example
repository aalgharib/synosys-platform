# =====================================================
# Synosys Platform Environment Variables
# =====================================================
# Copy this file to .env.local for local development.
# On Vercel, set these in Project Settings → Environment Variables.
# =====================================================

# Claude (chat-driven video editing)
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (Whisper transcription for caption sync)
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Vercel Blob (video uploads + rendered outputs)
# Auto-populated when you add a Blob store in Vercel.
# For local dev: vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
